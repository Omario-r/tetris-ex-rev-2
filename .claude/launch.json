{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flutter-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5959"
      ],
      "port": 5959
    },
    {
      "name": "design-mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5960",
        "--directory",
        "docs/design"
      ],
      "port": 5960
    }
  ]
}
